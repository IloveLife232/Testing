-- ============================================================
-- MAIN TAB
-- ============================================================
local Main = Window:CreateTab({Icon="⚔", Name="Main", ShowTitle=true})

Main:CreateSection("Movement")

Main:CreateSlider({
    Name="Walk speed", Range={16,200}, Increment=1, CurrentValue=16,
    Tooltip="Changes your walk speed — default is 16",
    Callback=function(v)
        pcall(function() LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid").WalkSpeed=v end)
    end,
})

Main:CreateSlider({
    Name="Jump power", Range={50,300}, Increment=1, CurrentValue=50,
    Tooltip="Changes your jump power — default is 50",
    Callback=function(v)
        pcall(function() LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid").JumpPower=v end)
    end,
})

Main:CreateSection("Modifications")

Main:CreateToggle({
    Name="God mode", CurrentValue=false,
    Description="Makes your character invincible — no damage taken",
    Tooltip="Toggle god mode on or off",
    Callback=function(v)
        pcall(function()
            local hum=LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
            hum.MaxHealth=v and math.huge or 100; hum.Health=hum.MaxHealth
        end)
    end,
})

Main:CreateToggle({
    Name="Noclip", CurrentValue=false,
    Description="Walk through walls and objects",
    Tooltip="Toggle noclip — lets you pass through parts",
    Callback=function(v) _G.OdysseyNoclip=v end,
})
RunService.Stepped:Connect(function()
    if _G.OdysseyNoclip then
        pcall(function()
            for _,p in ipairs(LocalPlayer.Character:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide=false end
            end
        end)
    end
end)

Main:CreateToggle({
    Name="Infinite jump", CurrentValue=false,
    Description="Allows jumping unlimited times in the air",
    Tooltip="Toggle infinite jump",
    Callback=function(v) _G.OdysseyInfJump=v end,
})
UserInputService.JumpRequest:Connect(function()
    if _G.OdysseyInfJump then
        pcall(function() LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping) end)
    end
end)

Main:CreateToggle({
    Name="Anti AFK", CurrentValue=true,
    Description="Prevents the game from kicking you for being idle",
    Tooltip="Keeps you active so you don't get kicked",
    Callback=function(v) _G.OdysseyAntiAFK=v end,
})
_G.OdysseyAntiAFK=true
local VU=game:GetService("VirtualUser")
LocalPlayer.Idled:Connect(function() if _G.OdysseyAntiAFK then VU:CaptureController(); VU:ClickButton2(Vector2.new()) end end)

Main:CreateSection("Fly")

local flyEnabled=false; local flyConn
Main:CreateToggle({
    Name="Fly", CurrentValue=false,
    Description="WASD to move, Space to go up, Left Ctrl to go down",
    Tooltip="Enable free flight around the map",
    Callback=function(v)
        flyEnabled=v
        pcall(function()
            local root=LocalPlayer.Character:FindFirstChild("HumanoidRootPart"); if not root then return end
            if flyEnabled then
                local bg=Instance.new("BodyGyro"); bg.MaxTorque=Vector3.new(1e9,1e9,1e9); bg.P=1e9; bg.Parent=root
                local bv=Instance.new("BodyVelocity"); bv.MaxForce=Vector3.new(1e9,1e9,1e9); bv.Velocity=Vector3.zero; bv.Parent=root
                flyConn=RunService.Heartbeat:Connect(function()
                    local cam=workspace.CurrentCamera; local spd=_G.OdysseyFlySpeed or 50; local vel=Vector3.zero
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then vel=vel+cam.CFrame.LookVector*spd end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then vel=vel-cam.CFrame.LookVector*spd end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then vel=vel-cam.CFrame.RightVector*spd end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then vel=vel+cam.CFrame.RightVector*spd end
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel=vel+Vector3.new(0,spd,0) end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vel=vel-Vector3.new(0,spd,0) end
                    bv.Velocity=vel; bg.CFrame=cam.CFrame
                end)
            else
                if flyConn then flyConn:Disconnect(); flyConn=nil end
                for _,v2 in ipairs(root:GetChildren()) do if v2:IsA("BodyGyro") or v2:IsA("BodyVelocity") then v2:Destroy() end end
            end
        end)
    end,
})

Main:CreateSlider({
    Name="Fly speed", Range={10,300}, Increment=5, CurrentValue=50,
    Tooltip="How fast you move while flying",
    Callback=function(v) _G.OdysseyFlySpeed=v end,
})
_G.OdysseyFlySpeed=50

Main:CreateSection("Actions")

Main:CreateButton({
    Name="Respawn",
    Description="Respawns your character at the spawn point",
    Tooltip="Kills and respawns your character",
    Callback=function() LocalPlayer:LoadCharacter() end,
})

Main:CreateButton({
    Name="Teleport to spawn",
