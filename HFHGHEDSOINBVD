local Player = Window:CreateTab({Icon="👤", Name="Player", ShowTitle=true})

Player:CreateSection("Target")

local playerDD=Player:CreateDropdown({
    Name="Select player",
    Description="Auto-updates when players join or leave",
    Options={""},
    SpecialType="Player",
    Tooltip="Pick a player to perform actions on",
    Callback=function(v) _G.OdysseyTarget=v end,
})

Player:CreateSection("Actions")

Player:CreateButton({
    Name="Teleport to player",
    Description="Teleport yourself to the selected player",
    Tooltip="Instantly moves you to the target player",
    Callback=function()
        pcall(function()
            local t=Players:FindFirstChild(playerDD:GetValue())
            if t and t.Character then LocalPlayer.Character.HumanoidRootPart.CFrame=t.Character.HumanoidRootPart.CFrame+Vector3.new(0,3,0) end
        end)
    end,
})

Player:CreateButton({
    Name="Bring player to me",
    Description="Teleports the selected player to your location",
    Tooltip="Pulls the target player to where you are",
    Callback=function()
        pcall(function()
            local t=Players:FindFirstChild(playerDD:GetValue())
            if t and t.Character then t.Character.HumanoidRootPart.CFrame=LocalPlayer.Character.HumanoidRootPart.CFrame+Vector3.new(3,0,0) end
        end)
    end,
})

Player:CreateSection("Info")

local pNameL=Player:CreateLabel({Text="Name: —",Style=1})
local pIdL=Player:CreateLabel({Text="User ID: —",Style=1})
local pTeamL=Player:CreateLabel({Text="Team: —",Style=1})
local pDistL=Player:CreateLabel({Text="Distance: —",Style=1})

RunService.Heartbeat:Connect(function()
    pcall(function()
        local t=Players:FindFirstChild(playerDD:GetValue()); if not t then return end
        pNameL:Set({Text="Name: "..t.DisplayName})
        pIdL:Set({Text="User ID: "..tostring(t.UserId)})
        pTeamL:Set({Text="Team: "..(t.Team and t.Team.Name or "None")})
        if t.Character and LocalPlayer.Character then
            pDistL:Set({Text="Distance: "..math.floor((t.Character.HumanoidRootPart.Position-LocalPlayer.Character.HumanoidRootPart.Position).Magnitude).." studs"})
        end
    end)
end)

