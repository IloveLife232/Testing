Tabs.Player:CreateSection("Info")

local _, pName = Tabs.Player:CreateLabel({Text="Name: —", Style=1}), nil
local _, pDist = Tabs.Player:CreateLabel({Text="Distance: —", Style=1}), nil

local pNameLbl = Tabs.Player:CreateLabel({Text="Name: —",     Style=1})
local pDistLbl = Tabs.Player:CreateLabel({Text="Distance: —", Style=1})
local pIdLbl   = Tabs.Player:CreateLabel({Text="User ID: —",  Style=1})
local pTeamLbl = Tabs.Player:CreateLabel({Text="Team: —",     Style=1})

RunService.Heartbeat:Connect(function()
    pcall(function()
        local target = Players:FindFirstChild(playerDD:GetValue())
        if target then
            pNameLbl:Set({Text="Name: "..target.DisplayName})
            pIdLbl:Set({Text="User ID: "..tostring(target.UserId)})
            pTeamLbl:Set({Text="Team: "..(target.Team and target.Team.Name or "None")})
            if target.Character and LocalPlayer.Character then
                local dist = math.floor((target.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude)
                pDistLbl:Set({Text="Distance: "..dist.." studs"})
            end
        end
    end)
end)

